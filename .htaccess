# =============================================================
# Apache config για shared hosting (Namecheap / cPanel)
# Αντιγράφεται αυτόματα στο dist/ σε κάθε `npm run build`.
#
# Καλύπτει: HTTPS + www, cache, συμπίεση, βασικά security headers.
# =============================================================

Options -Indexes

# -------------------------------------------------------------
# 1. HTTPS και www σε ΕΝΑ redirect
#    Το canonical του site είναι https://www.nikoletamouratidou.gr
#    Αν προτιμηθεί ΧΩΡΙΣ www, αλλάξτε και: astro.config.mjs (site),
#    public/robots.txt, public/sitemap.xml.
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+?)\.?$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]
</IfModule>

# -------------------------------------------------------------
# 2. Cache
#    Τα αρχεία στο /_astro/ έχουν hash στο όνομα (π.χ.
#    index.-pl5K2iJ.css), οπότε είναι ασφαλές να μείνουν έναν χρόνο.
#    Το favicon.svg / og-image.png ΔΕΝ έχουν hash — μένουν έξω.
# -------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.[A-Za-z0-9_-]{8,}\.(css|js|webp|avif|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 hour"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType image/webp              "access plus 7 days"
  ExpiresByType image/png               "access plus 7 days"
  ExpiresByType image/jpeg              "access plus 7 days"
  ExpiresByType image/svg+xml           "access plus 7 days"
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
</IfModule>

# -------------------------------------------------------------
# 3. Συμπίεση
# -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# -------------------------------------------------------------
# 4. MIME types (σε περίπτωση που λείπουν από τον server)
# -------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp              .webp
  AddType image/avif              .avif
  AddType image/svg+xml           .svg
  AddType font/woff2              .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# -------------------------------------------------------------
# 5. Security headers
# -------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# -------------------------------------------------------------
# 6. UTF-8 (ο ιστότοπος είναι εξ ολοκλήρου στα ελληνικά)
# -------------------------------------------------------------
AddDefaultCharset UTF-8
