---
/**
 * Το σήμα των τριών τεμνόμενων κύκλων, ξαναχτισμένο ως γεωμετρία.
 * Αναλογίες παρμένες από το logo.pdf:
 *   ισόπλευρο τρίγωνο κέντρων, ακτίνα κύκλου ≈ 1.62 × περίκεντρη ακτίνα.
 *
 * Κάθε κύκλος είναι ένας «κόμβος» (n1/n2/n3). Η κλάση του κόμβου μπαίνει
 * ΚΑΙ στον ορατό κύκλο ΚΑΙ στον αντίστοιχο κύκλο του clipPath, ώστε η τομή
 * να ακολουθεί πάντα τους κύκλους — και στην αργή κίνηση και στη σύγκλιση.
 */
interface Props {
  /** Πάχος γραμμής στο σύστημα συντεταγμένων του viewBox (200×200). */
  stroke?: number;
  /** Γέμισμα της τριπλής τομής. */
  fillCore?: boolean;
  /** Αργή, συνεχής κίνηση. */
  drift?: boolean;
  /** Επιτρέπει σύγκλιση μέσω της μεταβλητής --cv (0→1). */
  interactive?: boolean;
  class?: string;
  title?: string;
}

const {
  stroke = 1,
  fillCore = true,
  drift = false,
  interactive = false,
  class: className = '',
  title,
} = Astro.props;

const uid = 'cm' + Math.random().toString(36).slice(2, 9);

/* Κέντρα: κορυφή, κάτω-αριστερά, κάτω-δεξιά */
const R = 60;
const C = [
  { cx: 100, cy: 72 },
  { cx: 68, cy: 127.5 },
  { cx: 132, cy: 127.5 },
] as const;
---

<svg
  class:list={[
    'circles',
    drift && 'circles--drift',
    interactive && 'circles--interactive',
    className,
  ]}
  viewBox="0 0 200 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  data-converge={interactive ? '' : undefined}
>
  {title && <title>{title}</title>}

  {
    fillCore && (
      <defs>
        <clipPath id={`${uid}-a`}>
          <circle class="circles__n1" cx={C[0].cx} cy={C[0].cy} r={R} />
        </clipPath>
        <clipPath id={`${uid}-b`} clip-path={`url(#${uid}-a)`}>
          <circle class="circles__n2" cx={C[1].cx} cy={C[1].cy} r={R} />
        </clipPath>
        <clipPath id={`${uid}-c`} clip-path={`url(#${uid}-b)`}>
          <circle class="circles__n3" cx={C[2].cx} cy={C[2].cy} r={R} />
        </clipPath>
      </defs>
    )
  }

  <g class="circles__ring circles__n1">
    <circle cx={C[0].cx} cy={C[0].cy} r={R} stroke="currentColor" stroke-width={stroke} />
  </g>
  <g class="circles__ring circles__n2">
    <circle cx={C[1].cx} cy={C[1].cy} r={R} stroke="currentColor" stroke-width={stroke} />
  </g>
  <g class="circles__ring circles__n3">
    <circle cx={C[2].cx} cy={C[2].cy} r={R} stroke="currentColor" stroke-width={stroke} />
  </g>

  {
    /* Το γέμισμα είναι ΑΜΕΤΑΚΙΝΗΤΟ ορθογώνιο, κομμένο από τους τρεις κύκλους.
       Αν το ίδιο μετακινούνταν, το clip του (userSpaceOnUse) θα κληρονομούσε
       κι αυτό τη μετατόπιση — και η τομή θα ξέφευγε από τους κύκλους. */
    fillCore && (
      <rect
        class="circles__core"
        x="0"
        y="0"
        width="200"
        height="200"
        clip-path={`url(#${uid}-c)`}
      />
    )
  }
</svg>

<style>
  .circles {
    /* --cv: 0 → κύκλοι στη θέση τους· 1 → μαζεμένοι προς το κέντρο */
    --cv: 0;
    --cv-amp: 5;

    inline-size: 100%;
    block-size: auto;
    color: var(--c-olive);
    overflow: visible;
  }

  .circles__core {
    fill: var(--c-olive-mist);
  }

  .circles__ring {
    transform-origin: 100px 100px;
  }

  /* ---------------------------------------------------------------
     Σύγκλιση: κάθε κόμβος κινείται προς το κοινό κέντρο (100, 109).
     Μοναδιαία διανύσματα: n1 (0,1) · n2 (0.866,−0.5) · n3 (−0.866,−0.5)
     --------------------------------------------------------------- */
  .circles__n1 {
    translate: 0 calc(var(--cv) * var(--cv-amp) * 1px);
  }

  .circles__n2 {
    translate: calc(var(--cv) * var(--cv-amp) * 0.866px)
      calc(var(--cv) * var(--cv-amp) * -0.5px);
  }

  .circles__n3 {
    translate: calc(var(--cv) * var(--cv-amp) * -0.866px)
      calc(var(--cv) * var(--cv-amp) * -0.5px);
  }

  /* ---------------------------------------------------------------
     Αργή κίνηση — η ίδια για τον κύκλο και για το clip του,
     ώστε η τομή να μένει πάντα ευθυγραμμισμένη.
     --------------------------------------------------------------- */
  .circles--drift .circles__n1 {
    animation: drift-a var(--dur-amb-slow) var(--ease-in-out-soft) infinite;
  }

  .circles--drift .circles__n2 {
    animation: drift-b var(--dur-amb) var(--ease-in-out-soft) infinite;
  }

  .circles--drift .circles__n3 {
    animation: drift-c calc(var(--dur-amb) * 1.28) var(--ease-in-out-soft) infinite;
  }

  .circles--drift .circles__core {
    animation: core-breathe var(--dur-amb-slow) var(--ease-in-out-soft) infinite;
  }

  @keyframes core-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.68;
    }
  }

  @keyframes drift-a {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(0, -5px);
    }
  }

  @keyframes drift-b {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(4.5px, 3px);
    }
  }

  @keyframes drift-c {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-4.5px, 3.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .circles--drift .circles__n1,
    .circles--drift .circles__n2,
    .circles--drift .circles__n3,
    .circles--drift .circles__core {
      animation: none;
    }

    .circles {
      --cv: 0 !important;
    }
  }
</style>
