---
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'quiet';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
  'data-scroll'?: boolean;
}

const {
  href,
  variant = 'solid',
  size = 'md',
  type = 'button',
  class: className = '',
  id,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const cls = ['btn', `btn--${variant}`, `btn--${size}`, className];
---

<Tag class:list={cls} href={href} type={href ? undefined : type} id={id} data-scroll={href?.startsWith('#') ? '' : undefined}>
  <span class="btn__label"><slot /></span>
  {variant === 'quiet' && <span class="btn__arrow" aria-hidden="true">↓</span>}
</Tag>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-fg: var(--text);
    --btn-bd: transparent;

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7em;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--btn-fg);
    background-color: var(--btn-bg);
    border: var(--bw-hair) solid var(--btn-bd);
    border-radius: var(--r-pill);
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
    isolation: isolate;
    overflow: hidden;
    transition:
      color var(--dur-md) var(--ease-out-soft),
      border-color var(--dur-md) var(--ease-out-soft),
      background-color var(--dur-md) var(--ease-out-soft);
  }

  .btn--sm {
    padding: 0.92em 1.5em;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }

  .btn--md {
    padding: 1.05em 1.9em;
  }

  .btn--lg {
    padding: 1.25em 2.4em;
    font-size: 0.9375rem;
  }

  /* Γέμισμα που ανεβαίνει αργά από κάτω στο hover */
  .btn--solid,
  .btn--outline {
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      transform: translateY(101%);
      transition: transform var(--dur-md) var(--ease-out-soft);
    }
  }

  .btn__label {
    display: block;
  }

  /* ---------- solid ---------- */
  .btn--solid {
    --btn-bg: var(--c-ink);
    --btn-fg: var(--c-ivory);
    --btn-bd: var(--c-ink);
  }

  .btn--solid::before {
    background-color: var(--c-olive-deep);
  }

  .btn--solid:hover,
  .btn--solid:focus-visible {
    --btn-bd: var(--c-olive-deep);
  }

  .btn--solid:hover::before,
  .btn--solid:focus-visible::before {
    transform: translateY(0);
  }

  /* ---------- outline ---------- */
  .btn--outline {
    --btn-bd: var(--line);
    --btn-fg: var(--text);
  }

  .btn--outline::before {
    background-color: var(--c-ink);
  }

  .btn--outline:hover,
  .btn--outline:focus-visible {
    --btn-fg: var(--c-ivory);
    --btn-bd: var(--c-ink);
  }

  .btn--outline:hover::before,
  .btn--outline:focus-visible::before {
    transform: translateY(0);
  }

  /* ---------- quiet (υπογραμμισμένο link) ---------- */
  .btn--quiet {
    padding: 0.5em 0;
    border-radius: 0;
    color: var(--text-soft);
    overflow: visible;
  }

  .btn--quiet .btn__label {
    position: relative;
    padding-block-end: 0.45em;
  }

  .btn--quiet .btn__label::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 1px;
    background-color: currentColor;
    transform-origin: left;
    transition: transform var(--dur-md) var(--ease-out-soft);
  }

  .btn--quiet:hover,
  .btn--quiet:focus-visible {
    color: var(--accent);
  }

  .btn--quiet:hover .btn__label::after,
  .btn--quiet:focus-visible .btn__label::after {
    transform: scaleX(0.3);
  }

  .btn__arrow {
    font-size: 0.9em;
    transition: transform var(--dur-md) var(--ease-out-soft);
  }

  .btn--quiet:hover .btn__arrow {
    transform: translateY(3px);
  }

  /* ---------- σε σκούρο φόντο ---------- */
  :global(.is-deep) .btn--solid {
    --btn-bg: var(--c-ivory);
    --btn-fg: var(--c-ink);
    --btn-bd: var(--c-ivory);
  }

  :global(.is-deep) .btn--solid::before {
    background-color: var(--c-olive-mist);
  }

  :global(.is-deep) .btn--outline {
    --btn-bd: var(--line-on-deep);
    --btn-fg: var(--text-on-deep);
  }

  :global(.is-deep) .btn--outline::before {
    background-color: var(--c-ivory);
  }

  :global(.is-deep) .btn--outline:hover,
  :global(.is-deep) .btn--outline:focus-visible {
    --btn-fg: var(--c-ink);
  }

  :global(.is-deep) .btn--quiet {
    color: var(--text-on-deep-muted);
  }

  :global(.is-deep) .btn--quiet:hover {
    color: var(--c-terracotta-soft);
  }

  @media (max-width: 479px) {
    .btn--md,
    .btn--lg {
      inline-size: 100%;
    }

    .btn--quiet {
      inline-size: auto;
    }
  }
</style>
