# Αυτόματη δημοσίευση στο GitHub Pages σε κάθε push στο main.
#
# ΓΙΑ ΝΑ ΕΝΕΡΓΟΠΟΙΗΘΕΙ (μία φορά):
#   1. mkdir -p .github/workflows && mv .github/deploy.yml.example .github/workflows/deploy.yml
#   2. Settings → Pages → Source: "GitHub Actions"
#
# Δεν μπήκε απευθείας στο .github/workflows/ επειδή το token του `gh` σε αυτό
# το μηχάνημα δεν έχει το scope `workflow`. Για να αποκτηθεί:
#   gh auth refresh -s workflow

name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - run: npm run build:pages
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
